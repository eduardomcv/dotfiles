{
	"$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
	"enabled": true,
	"autoUpdate": true,
	// Keep pruning quiet: a toast, not a chat message per prune.
	"pruneNotification": "minimal",
	"pruneNotificationType": "toast",
	// Do not prune tool output the model may still need this turn.
	"turnProtection": {
		"enabled": true,
		"turns": 4,
	},
	// Let subagent sessions benefit from the same pruning.
	"experimental": {
		"allowSubAgents": true,
	},
	"compress": {
		"mode": "range",
		"permission": "allow",
		"showCompression": false,
		"summaryBuffer": true,
		// Percentages adapt to each model's context window.
		"maxContextLimit": "65%",
		"minContextLimit": "30%",
		"nudgeFrequency": 5,
		"nudgeForce": "soft",
		// Never lose the user's own instructions during compression.
		"protectUserMessages": true,
	},
	"strategies": {
		"deduplication": {
			"enabled": true,
		},
		"purgeErrors": {
			"enabled": true,
			"turns": 4,
		},
	},
}
