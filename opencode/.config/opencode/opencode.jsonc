{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "plan",
	"model": "opencode/big-pickle",
	"shell": "zsh",
	"lsp": true,
	"formatter": true,
	"permissions": [
		{
			"action": "edit",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "git status*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git diff*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git log*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "ls*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rg*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "grep*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "cat*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "find*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk git status*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk git diff*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk git log*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk ls*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk rg*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk grep*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk read*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rtk find*",
			"effect": "allow"
		}
	],
	"agents": {
		"title": {
			"model": "opencode/mimo-v2.6-flash-free"
		}
	},
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git",
		"@tarquinen/opencode-dcp@latest",
		"openslimedit@latest",
		"@slkiser/opencode-quota@4",
		"envsitter-guard@latest",
		"@pantheon-ai/opencode-warcraft-notifications"
	],
	"mcp": {
		"servers": {
			"zennotes": {
				"disabled": false,
				"type": "local",
				"command": [
					"zn",
					"mcp"
				],
				"environment": {
					"PATH": "{env:HOME}/.local/bin:{env:PATH}"
				},
			}
		}
	},
	"providers": {
		// Detected copilot authentication; opencode-quota added this global provider declaration.
		"copilot": {},
		// Detected openai authentication; opencode-quota added this global provider declaration.
		"openai": {}
	}
}
