{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "plan",
	"model": "opencode/big-pickle",
	"small_model": "opencode/mimo-v2.6-flash-free",
	"shell": "zsh",
	"lsp": true,
	"formatter": true,
	"permission": {
		"edit": "ask",
		"bash": {
			"*": "ask",
			"git status*": "allow",
			"git diff*": "allow",
			"git log*": "allow",
			"ls*": "allow",
			"rg*": "allow",
			"grep*": "allow",
			"cat*": "allow",
			"find*": "allow",
			"rtk git status*": "allow",
			"rtk git diff*": "allow",
			"rtk git log*": "allow",
			"rtk ls*": "allow",
			"rtk rg*": "allow",
			"rtk grep*": "allow",
			"rtk read*": "allow",
			"rtk find*": "allow"
		}
	},
	"plugin": [
		"superpowers@git+https://github.com/obra/superpowers.git",
		"@tarquinen/opencode-dcp@latest",
		"openslimedit@latest",
		"@slkiser/opencode-quota@4"
	],
	"mcp": {
		"zennotes": {
			"enabled": true,
			"type": "local",
			"command": [
				"zn",
				"mcp"
			],
			"environment": {
				"PATH": "{env:HOME}/.local/bin:{env:PATH}"
			},
		}
	}
}
