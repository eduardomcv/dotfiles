{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg *)",
      "Bash(rtk git status *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk ls *)",
      "Bash(rtk rg *)",
      "Bash(rtk grep *)",
      "Bash(rtk read *)",
      "Bash(npx ctx7 *)",
      "Bash(npx ctx7@latest *)"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 51200,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "theme": "auto",
  "attribution": {
    "commit": ""
  }
}
