{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "theme": "auto",
  "bashOutputMaxChars": 51200,
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(rtk git status *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk ls *)",
      "Bash(rtk rg *)",
      "Bash(rtk grep *)",
      "Bash(rtk read *)",
      "Bash(rtk find *)",
      "Bash(npx ctx7 *)",
      "Bash(npx ctx7@latest *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers-marketplace.git"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
